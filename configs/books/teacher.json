{
  "schema_version": "books-next-item-v1",
  "model": {
    "variant": "T",
    "b_model": {
      "repo": "Qwen/Qwen3-0.6B-Base",
      "revision": "da87bfb608c14b7cf20ba1ce41287e8de496c0cd"
    }
  },
  "data": {
    "train_users": 50000,
    "dev_users": 5000,
    "selection_users": 2000,
    "test_users": 10000,
    "query_cap": 5,
    "history_max": 10
  },
  "training": {
    "epochs": 1,
    "effective_query_batch": 32,
    "microbatch_queries": 2,
    "backbone_lr": 1e-05,
    "head_lr": 0.0001,
    "betas": [
      0.9,
      0.95
    ],
    "eps": 1e-08,
    "weight_decay": 0.01,
    "warmup_ratio": 0.03,
    "min_lr_ratio": 0.1,
    "clip": 1.0,
    "compute_dtype": "bfloat16",
    "attention_backend": "flex_attention",
    "gradient_checkpointing": true,
    "max_reader_packed_tokens": 16384,
    "max_encoder_packed_tokens": 8192,
    "max_logical_tokens": 8192
  },
  "loss": {
    "recipe": "ce",
    "beta_final": 0.5,
    "beta_warmup_ratio": 0.1,
    "temperature": 1.0,
    "alignment_weight": 0.0,
    "raw_ce_weight": 0.0
  },
  "evaluation": {
    "selection_every": 1000,
    "full_epoch_end": true,
    "monitor_every": 250,
    "monitor_users": 100,
    "max_reader_packed_tokens": 65536
  },
  "checkpoint": {
    "first_step": 10,
    "every": 2000
  },
  "seed": 17
}
